# Copy to .env.local for local development. Never commit real secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Existing Supabase staff auth / quote intake (service role key remains server-only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
QUOTE_RATE_LIMIT_SECRET=

# Reserved unless the corresponding auth provider is enabled.
NEXTAUTH_SECRET=
JWT_SECRET=

# Managed PostgreSQL: pooled runtime URL + direct URL for Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# 32 bytes of random secret: 32 UTF-8 chars or 64 hex characters.
ENCRYPTION_KEY=

# Use one provider: EasyPost, or the custom HTTPS normalized tracking adapter.
EASYPOST_API_KEY=
ENABLE_LABEL_PURCHASES=false
CARRIER_TRACKING_URL=
CARRIER_API_KEY=
ENABLE_MOCK_TRACKING=false

# Shared Upstash Redis REST credentials for distributed API rate limiting.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
RATE_LIMIT_TRACKING_PER_MINUTE=30
RATE_LIMIT_QUOTES_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=20

# AI support. Keep the API key server-only.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
SUPPORT_NOTIFICATION_WEBHOOK_URL=

# Indicative estimate only; not a carrier-confirmed or binding rate.
QUOTE_BASE_RATE_USD=12
QUOTE_PER_KG_RATE_USD=2.4

# Seed only non-production databases; use a pre-hashed password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD_HASH=
ALLOW_PRODUCTION_SEED=false
