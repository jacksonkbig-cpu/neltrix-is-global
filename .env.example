# Copy to .env.local for local development. Never commit real secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Existing Supabase staff auth / quote intake (server-side service key must remain private).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
QUOTE_RATE_LIMIT_SECRET=

# Managed PostgreSQL: pooled runtime URL + direct URL used by Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Exactly 32 bytes of random secret, either 32 UTF-8 characters or 64 hex characters.
ENCRYPTION_KEY=

# Optional external carrier adapter. The endpoint must be HTTPS and return the documented normalized payload.
CARRIER_TRACKING_URL=
CARRIER_API_KEY=
ENABLE_MOCK_TRACKING=false

# Shared Upstash Redis REST credentials for distributed API rate limiting.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
RATE_LIMIT_TRACKING_PER_MINUTE=30
RATE_LIMIT_QUOTES_PER_MINUTE=10

# Seed only non-production databases. Store a pre-hashed password, never a plaintext password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD_HASH=
ALLOW_PRODUCTION_SEED=false
