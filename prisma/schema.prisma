generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
  OPERATIONS_STAFF
  CARRIER
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  EXCEPTION
}

enum QuoteStatus {
  // Legacy values remain during staged migration of existing quote records.
  PENDING
  PRICED
  REJECTED
  EXPIRED
  INDICATIVE
  BINDING
  ACCEPTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ChatSender {
  CUSTOMER
  AI
  ADMIN
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  role         UserRole    @default(USER)
  shipments    Shipment[]
  tickets      Ticket[]
  auditLogs    AuditLog[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([role])
}

model Shipment {
  id                String         @id @default(cuid())
  trackingNumber    String         @unique
  status            ShipmentStatus @default(PENDING)
  origin            String
  destination       String
  carrier           String
  estimatedDelivery DateTime?
  userId            String?
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model Quote {
  id          String      @id @default(cuid())
  senderZip   String
  receiverZip String
  origin      String
  destination String
  weight      Decimal     @db.Decimal(10, 2)
  dimensions  Json
  rate        Decimal     @db.Decimal(12, 2)
  currency    String      @default("USD") @db.Char(3)
  status      QuoteStatus @default(INDICATIVE)
  createdAt   DateTime    @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
}

model Ticket {
  id           String          @id @default(cuid())
  ticketNumber String          @unique
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  status       TicketStatus    @default(OPEN)
  priority     TicketPriority  @default(NORMAL)
  subject      String
  messages     ChatMessage[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, priority, updatedAt])
  @@index([userId, createdAt])
}

model ChatMessage {
  id             String     @id @default(cuid())
  ticketId       String
  ticket         Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender         ChatSender
  message        String     @db.Text
  isInternalNote Boolean    @default(false)
  createdAt      DateTime   @default(now())

  @@index([ticketId, createdAt])
  @@index([sender, createdAt])
}

model AuditLog {
  id        String    @id @default(cuid())
  action    String
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress String?
  userAgent String?
  timestamp DateTime  @default(now())

  @@index([userId, timestamp])
  @@index([timestamp])
  @@index([action, timestamp])
}
