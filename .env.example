# Copy to .env.local. Never commit real secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public project settings (the anon key is intended for browser use;
# row-level security must remain enabled).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never use NEXT_PUBLIC_ on these.
SUPABASE_SERVICE_ROLE_KEY=
QUOTE_RATE_LIMIT_SECRET=

# Future milestone only — do not configure payments until approved.
# PAYMENT_PROVIDER_API_KEY=
# PAYMENT_PROVIDER_WEBHOOK_SECRET=
